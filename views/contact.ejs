<div style="background:linear-gradient(135deg,#0d2e1e,#1a4731,#2d6a4f);padding:56px 0;text-align:center;color:#fff">
  <div class="container">
    <div class="hero-chip mx-auto mb-3"><i class="bi bi-envelope-fill"></i> Get in Touch</div>
    <h1 style="font-family:'Fraunces',serif;font-size:2.2rem;font-weight:600;letter-spacing:-0.5px;margin-bottom:8px">Contact Helnay</h1>
    <p style="color:rgba(255,255,255,0.7);font-size:15px">We're here to help. Reach out via any channel below.</p>
  </div>
</div>

<div class="container my-5">
  <!-- Contact Cards -->
  <div class="row g-3 mb-5">
    <div class="col-6 col-md-3">
      <div class="text-center p-4 rounded-4 h-100" style="background:#fff;border:1px solid var(--border)">
        <i class="bi bi-envelope-fill mb-3" style="font-size:1.8rem;color:var(--g2);display:block"></i>
        <div class="fw-bold small mb-1">Email</div>
        <a href="mailto:info@helnay.com" class="text-muted small" style="text-decoration:none">info@helnay.com</a>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="text-center p-4 rounded-4 h-100" style="background:#fff;border:1px solid var(--border)">
        <i class="bi bi-telephone-fill mb-3" style="font-size:1.8rem;color:var(--g2);display:block"></i>
        <div class="fw-bold small mb-1">Phone</div>
        <a href="tel:+447384221488" class="text-muted small" style="text-decoration:none">+44 7384 221488</a>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="text-center p-4 rounded-4 h-100" style="background:#fff;border:1px solid var(--border)">
        <i class="bi bi-whatsapp mb-3" style="font-size:1.8rem;color:#25d366;display:block"></i>
        <div class="fw-bold small mb-1">WhatsApp</div>
        <a href="https://wa.me/447944321650" target="_blank" class="text-muted small" style="text-decoration:none">+44 7944 321650</a>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="text-center p-4 rounded-4 h-100" style="background:#fff;border:1px solid var(--border)">
        <i class="bi bi-clock-fill mb-3" style="font-size:1.8rem;color:var(--g2);display:block"></i>
        <div class="fw-bold small mb-1">Hours</div>
        <span class="text-muted small">Mon–Fri: 9AM–6PM EAT</span>
      </div>
    </div>
  </div>

  <div class="row g-5 justify-content-center">
    <div class="col-lg-7">
      <div class="p-4 p-md-5 rounded-4" style="background:#fff;border:1px solid var(--border)">
        <h3 style="font-family:'Fraunces',serif;font-weight:600;margin-bottom:4px">Send a Message</h3>
        <p class="text-muted small mb-4">We respond within 2 hours during business hours.</p>
        <% if (typeof message !== 'undefined' && message) { %>
          <div class="alert alert-success" style="border-radius:10px"><i class="bi bi-check-circle-fill me-2"></i><%= message %></div>
        <% } %>
        <form method="POST" action="/contact">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label fw-bold small" style="color:var(--hint);text-transform:uppercase;letter-spacing:.4px">Your Name</label>
              <input type="text" name="name" class="form-control" placeholder="Ahmed Mohamed" required style="border-radius:10px;padding:10px 13px">
            </div>
            <div class="col-md-6">
              <label class="form-label fw-bold small" style="color:var(--hint);text-transform:uppercase;letter-spacing:.4px">Email</label>
              <input type="email" name="email" class="form-control" placeholder="you@example.com" required style="border-radius:10px;padding:10px 13px">
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label fw-bold small" style="color:var(--hint);text-transform:uppercase;letter-spacing:.4px">Subject</label>
            <select name="subject" class="form-select" style="border-radius:10px;padding:10px 13px">
              <option>General Enquiry</option>
              <option>Booking Support</option>
              <option>List My Property</option>
              <option>Payment Issue</option>
              <option>Report a Problem</option>
            </select>
          </div>
          <div class="mb-4">
            <label class="form-label fw-bold small" style="color:var(--hint);text-transform:uppercase;letter-spacing:.4px">Message</label>
            <textarea name="message" class="form-control" rows="5" placeholder="Tell us how we can help…" required style="border-radius:10px;padding:10px 13px;resize:vertical"></textarea>
          </div>
          <button type="submit" class="btn btn-primary w-100 fw-bold py-3" style="border-radius:12px;font-size:15px;background:linear-gradient(135deg,#1a4731,#2d6a4f);border:none">
            <i class="bi bi-send-fill me-2"></i> Send Message
          </button>
        </form>
      </div>
    </div>
  </div>
</div>
