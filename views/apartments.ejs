<!-- Hero Section -->
<div class="hero-banner text-white text-center position-relative" style="background: linear-gradient(rgba(240, 147, 251, 0.85), rgba(245, 87, 108, 0.85)), url('https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?w=1920&q=80&auto=format&fit=crop') center/cover; padding: 4rem 0 3rem; min-height: 400px; display: flex; align-items: center;">
  <div class="container">
    <h1 class="display-4 fw-bold mb-3">
      <i class="bi bi-house-door me-2"></i>Comfortable Apartments
    </h1>
    <p class="lead mb-4">Find your perfect apartment rental with all the comforts of home</p>
    
    <!-- Search Box -->
    <div class="search-container mx-auto" style="max-width: 700px;">
      <form action="/apartments" method="GET" class="bg-white rounded-4 p-3 shadow-lg">
        <div class="row g-2 align-items-end">
          <div class="col-md-4">
            <label class="form-label text-dark small mb-1">Location</label>
            <div class="loc-ac-wrap">
              <input type="text" name="location" class="form-control border-0 bg-light loc-ac-input"
                     placeholder="City or location" value="<%= query.location || '' %>" autocomplete="off">
              <ul class="loc-ac-dropdown"></ul>
            </div>
          </div>
          <div class="col-md-3">
            <label class="form-label text-dark small mb-1">Bedrooms</label>
            <select name="bedrooms" class="form-select border-0 bg-light">
              <option value="">Any</option>
              <option value="1" <%= query.bedrooms === '1' ? 'selected' : '' %>>1+</option>
              <option value="2" <%= query.bedrooms === '2' ? 'selected' : '' %>>2+</option>
              <option value="3" <%= query.bedrooms === '3' ? 'selected' : '' %>>3+</option>
              <option value="4" <%= query.bedrooms === '4' ? 'selected' : '' %>>4+</option>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label text-dark small mb-1">Guests</label>
            <select name="guests" class="form-select border-0 bg-light">
              <option value="">Any</option>
              <option value="1" <%= query.guests === '1' ? 'selected' : '' %>>1+</option>
              <option value="2" <%= query.guests === '2' ? 'selected' : '' %>>2+</option>
              <option value="4" <%= query.guests === '4' ? 'selected' : '' %>>4+</option>
              <option value="6" <%= query.guests === '6' ? 'selected' : '' %>>6+</option>
            </select>
          </div>
          <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100 fw-semibold py-2">
              <i class="bi bi-search me-1"></i>Search
            </button>
          </div>
        </div>
        
        <!-- Advanced Filters (collapsible) -->
        <div class="mt-2">
          <button class="btn btn-link text-decoration-none text-dark p-0 small" type="button" 
                  data-bs-toggle="collapse" data-bs-target="#advancedFilters">
            <i class="bi bi-sliders"></i> More filters
          </button>
        </div>
        
        <div class="collapse mt-2" id="advancedFilters">
          <div class="row g-2">
            <div class="col-md-6">
              <label class="form-label text-dark small mb-1">Min Price ($/night)</label>
              <input type="number" name="min_price" class="form-control border-0 bg-light" 
                     placeholder="0" value="<%= query.min_price || '' %>">
            </div>
            <div class="col-md-6">
              <label class="form-label text-dark small mb-1">Max Price ($/night)</label>
              <input type="number" name="max_price" class="form-control border-0 bg-light" 
                     placeholder="1000" value="<%= query.max_price || '' %>">
            </div>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Listings Section -->
<div class="container my-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="h4 mb-1">Available Apartments</h2>
      <p class="text-muted mb-0"><%= listings.length %> properties found</p>
    </div>
    
    <!-- Sort Options -->
    <div class="dropdown">
      <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
        <i class="bi bi-sort-down"></i> Sort by
      </button>
      <ul class="dropdown-menu">
        <li><a class="dropdown-item" href="/apartments?sort=newest<%= query.location ? '&location=' + query.location : '' %><%= query.min_price ? '&min_price=' + query.min_price : '' %><%= query.max_price ? '&max_price=' + query.max_price : '' %><%= query.bedrooms ? '&bedrooms=' + query.bedrooms : '' %><%= query.guests ? '&guests=' + query.guests : '' %>">Newest First</a></li>
        <li><a class="dropdown-item" href="/apartments?sort=price_low<%= query.location ? '&location=' + query.location : '' %><%= query.min_price ? '&min_price=' + query.min_price : '' %><%= query.max_price ? '&max_price=' + query.max_price : '' %><%= query.bedrooms ? '&bedrooms=' + query.bedrooms : '' %><%= query.guests ? '&guests=' + query.guests : '' %>">Price: Low to High</a></li>
        <li><a class="dropdown-item" href="/apartments?sort=price_high<%= query.location ? '&location=' + query.location : '' %><%= query.min_price ? '&min_price=' + query.min_price : '' %><%= query.max_price ? '&max_price=' + query.max_price : '' %><%= query.bedrooms ? '&bedrooms=' + query.bedrooms : '' %><%= query.guests ? '&guests=' + query.guests : '' %>">Price: High to Low</a></li>
      </ul>
    </div>
  </div>
  
  <% if (listings.length === 0) { %>
    <div class="text-center py-5">
      <i class="bi bi-house-door display-1 text-muted"></i>
      <h3 class="mt-3">No apartments found</h3>
      <p class="text-muted">Try adjusting your search filters</p>
      <a href="/apartments" class="btn btn-primary">Clear Filters</a>
    </div>
  <% } else { %>
    <div class="row g-4">
      <% listings.forEach(listing => { %>
        <div class="col-md-6 col-lg-4">
          <div class="card h-100 border-0 shadow-sm listing-card">
            <div class="position-relative">
              <img src="<%= listing.image_url || '/uploads/placeholder.jpg' %>" 
                   class="card-img-top" alt="<%= listing.title %>" 
                   style="height: 250px; object-fit: cover;">
              
              <% if (user) { %>
                <form method="POST" action="<%= favoriteIds.includes(listing.id) ? '/favorites/remove' : '/favorites/add' %>" 
                      class="favorite-form position-absolute top-0 end-0 m-2">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="listing_id" value="<%= listing.id %>">
                  <button type="submit" class="btn btn-light btn-sm rounded-circle shadow-sm" 
                          style="width: 36px; height: 36px;">
                    <i class="bi bi-heart<%= favoriteIds.includes(listing.id) ? '-fill text-danger' : '' %>"></i>
                  </button>
                </form>
              <% } %>
            </div>
            
            <div class="card-body">
              <h5 class="card-title mb-2">
                <a href="/listings/<%= listing.id %>" class="text-decoration-none text-dark">
                  <%= listing.title %>
                </a>
              </h5>
              
              <p class="text-muted small mb-2">
                <i class="bi bi-geo-alt"></i> <%= listing.location_name || listing.location || 'Location not specified' %>
              </p>

              <p class="card-text text-muted small mb-3">
                <%= listing.description ? (listing.description.length > 110 ? listing.description.substring(0, 110) + '...' : listing.description) : 'No details available for this property yet.' %>
              </p>
              
              <div class="d-flex gap-3 text-muted small mb-2">
                <% if (listing.bedrooms) { %>
                  <span><i class="bi bi-door-closed"></i> <%= listing.bedrooms %> beds</span>
                <% } %>
                <% if (listing.max_guests) { %>
                  <span><i class="bi bi-people"></i> <%= listing.max_guests %> guests</span>
                <% } %>
              </div>
              
              <div class="d-flex justify-content-between align-items-center mt-3">
                <div>
                  <strong class="h5 mb-0 text-primary">$<%= listing.price %></strong>
                  <small class="text-muted">/night</small>
                </div>
                <a href="/listings/<%= listing.id %>" class="btn btn-outline-primary btn-sm">View Details</a>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>

<style>
.listing-card {
  transition: transform 0.2s, box-shadow 0.2s;
}
.listing-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.15) !important;
}
.favorite-form button {
  backdrop-filter: blur(10px);
}
</style>

<script>
// Auto-submit favorite forms
document.querySelectorAll('.favorite-form').forEach(form => {
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const response = await fetch(form.action, {
      method: 'POST',
      body: formData
    });
    if (response.ok) {
      location.reload();
    }
  });
});
</script>



<script>
(function() {
  const LOCATIONS = <%- JSON.stringify(locations.map(l => l.name)) %>;

  function initLocationAC(wrap) {
    const input = wrap.querySelector('.loc-ac-input');
    const dropdown = wrap.querySelector('.loc-ac-dropdown');
    let activeIdx = -1;
    let open = false;

    function highlight(text, query) {
      if (!query) return text;
      const idx = text.toLowerCase().indexOf(query.toLowerCase());
      if (idx === -1) return text;
      return text.slice(0, idx) + '<em>' + text.slice(idx, idx + query.length) + '</em>' + text.slice(idx + query.length);
    }

    function renderList(query) {
      const matches = query.length === 0
        ? LOCATIONS
        : LOCATIONS.filter(l => l.toLowerCase().includes(query.toLowerCase()));
      dropdown.innerHTML = '';
      activeIdx = -1;
      if (matches.length === 0) {
        dropdown.innerHTML = '<li class="loc-ac-no-results">No matching locations found</li>';
      } else {
        matches.slice(0, 20).forEach((loc, i) => {
          const li = document.createElement('li');
          li.innerHTML = '<span class="ac-icon"><i class="bi bi-geo-alt-fill"></i></span>' + highlight(loc, query);
          li.addEventListener('mousedown', (e) => {
            e.preventDefault();
            input.value = loc;
            closeDropdown();
          });
          dropdown.appendChild(li);
        });
      }
    }

    function openDropdown() {
      renderList(input.value.trim());
      dropdown.style.display = 'block';
      open = true;
    }

    function closeDropdown() {
      dropdown.style.display = 'none';
      open = false;
      activeIdx = -1;
    }

    function setActive(idx) {
      const items = dropdown.querySelectorAll('li:not(.loc-ac-no-results)');
      items.forEach(li => li.classList.remove('ac-active'));
      if (idx >= 0 && idx < items.length) {
        items[idx].classList.add('ac-active');
        items[idx].scrollIntoView({ block: 'nearest' });
        activeIdx = idx;
      } else {
        activeIdx = -1;
      }
    }

    input.addEventListener('focus', () => openDropdown());
    input.addEventListener('input', () => { renderList(input.value.trim()); if (!open) openDropdown(); });
    input.addEventListener('blur', () => setTimeout(closeDropdown, 150));
    input.addEventListener('keydown', (e) => {
      const items = dropdown.querySelectorAll('li:not(.loc-ac-no-results)');
      if (e.key === 'ArrowDown') { e.preventDefault(); setActive(Math.min(activeIdx + 1, items.length - 1)); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(Math.max(activeIdx - 1, 0)); }
      else if (e.key === 'Enter' && activeIdx >= 0) { e.preventDefault(); input.value = items[activeIdx].textContent.trim(); closeDropdown(); }
      else if (e.key === 'Escape') closeDropdown();
    });
  }

  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.loc-ac-wrap').forEach(initLocationAC);
  });
})();
</script>

<style>
.loc-ac-wrap { position: relative; }
.loc-ac-dropdown {
  display: none;
  position: absolute;
  top: calc(100% + 2px);
  left: 0; right: 0;
  background: #fff;
  border: 1px solid #dee2e6;
  border-radius: 0.5rem;
  box-shadow: 0 4px 16px rgba(0,0,0,0.12);
  z-index: 1050;
  max-height: 230px;
  overflow-y: auto;
  list-style: none;
  margin: 0;
  padding: 4px 0;
}
.loc-ac-dropdown li {
  padding: 9px 14px;
  cursor: pointer;
  font-size: 0.9rem;
  display: flex;
  align-items: center;
  gap: 7px;
  color: #333;
  transition: background 0.1s;
}
.loc-ac-dropdown li:hover,
.loc-ac-dropdown li.ac-active {
  background: #f0f4ff;
  color: #0d6efd;
}
.loc-ac-dropdown li .ac-icon { color: #6c757d; font-size: 0.85rem; }
.loc-ac-dropdown li em { font-style: normal; font-weight: 600; }
.loc-ac-no-results { padding: 10px 14px; color: #999; font-size: 0.85rem; pointer-events: none; }
</style>

<script>
(function() {
  const LOCATIONS = <%- JSON.stringify(locations.map(l => l.name)) %>;

  function initLocationAC(wrap) {
    const input = wrap.querySelector('.loc-ac-input');
    const dropdown = wrap.querySelector('.loc-ac-dropdown');
    let activeIdx = -1;

    function highlight(text, query) {
      if (!query) return text;
      const i = text.toLowerCase().indexOf(query.toLowerCase());
      if (i === -1) return text;
      return text.slice(0,i) + '<em>' + text.slice(i, i+query.length) + '</em>' + text.slice(i+query.length);
    }

    function renderList(query) {
      const matches = query ? LOCATIONS.filter(l => l.toLowerCase().includes(query.toLowerCase())) : LOCATIONS;
      dropdown.innerHTML = '';
      activeIdx = -1;
      if (!matches.length) {
        dropdown.innerHTML = '<li class="loc-ac-no-results">No locations found</li>';
      } else {
        matches.slice(0,20).forEach(loc => {
          const li = document.createElement('li');
          li.innerHTML = '<span class="ac-icon"><i class="bi bi-geo-alt-fill"></i></span>' + highlight(loc, query);
          li.addEventListener('mousedown', e => { e.preventDefault(); input.value = loc; dropdown.style.display='none'; });
          dropdown.appendChild(li);
        });
      }
    }

    input.addEventListener('focus', () => { renderList(input.value.trim()); dropdown.style.display='block'; });
    input.addEventListener('input', () => { renderList(input.value.trim()); dropdown.style.display='block'; });
    input.addEventListener('blur', () => setTimeout(() => dropdown.style.display='none', 150));
    input.addEventListener('keydown', e => {
      const items = dropdown.querySelectorAll('li:not(.loc-ac-no-results)');
      if (e.key==='ArrowDown') { e.preventDefault(); activeIdx=Math.min(activeIdx+1,items.length-1); items.forEach((l,i)=>l.classList.toggle('ac-active',i===activeIdx)); items[activeIdx]?.scrollIntoView({block:'nearest'}); }
      else if (e.key==='ArrowUp') { e.preventDefault(); activeIdx=Math.max(activeIdx-1,0); items.forEach((l,i)=>l.classList.toggle('ac-active',i===activeIdx)); items[activeIdx]?.scrollIntoView({block:'nearest'}); }
      else if (e.key==='Enter' && activeIdx>=0) { e.preventDefault(); input.value=items[activeIdx].textContent.trim(); dropdown.style.display='none'; }
      else if (e.key==='Escape') dropdown.style.display='none';
    });
  }

  document.addEventListener('DOMContentLoaded', () => document.querySelectorAll('.loc-ac-wrap').forEach(initLocationAC));
})();
</script>

