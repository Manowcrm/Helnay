<%- include('layout') %>

<div class="container my-5">
  <h1 class="mb-4"><i class="bi bi-calendar-check"></i> My Bookings</h1>
  
  <!-- Tabs for different booking categories -->
  <ul class="nav nav-tabs mb-4" id="bookingTabs" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link active" id="current-tab" data-bs-toggle="tab" data-bs-target="#current" type="button" role="tab">
        <i class="bi bi-calendar-event"></i> Current Bookings 
        <% if (currentBookings && currentBookings.length > 0) { %>
          <span class="badge bg-primary ms-1"><%= currentBookings.length %></span>
        <% } %>
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="pending-tab" data-bs-toggle="tab" data-bs-target="#pending" type="button" role="tab">
        <i class="bi bi-clock-history"></i> Pending 
        <% if (pendingBookings && pendingBookings.length > 0) { %>
          <span class="badge bg-warning ms-1"><%= pendingBookings.length %></span>
        <% } %>
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="previous-tab" data-bs-toggle="tab" data-bs-target="#previous" type="button" role="tab">
        <i class="bi bi-check-circle"></i> Previous Bookings
        <% if (previousBookings && previousBookings.length > 0) { %>
          <span class="badge bg-secondary ms-1"><%= previousBookings.length %></span>
        <% } %>
      </button>
    </li>
  </ul>

  <!-- Tab Content -->
  <div class="tab-content" id="bookingTabContent">
    
    <!-- Current Bookings -->
    <div class="tab-pane fade show active" id="current" role="tabpanel">
      <% if (currentBookings && currentBookings.length > 0) { %>
        <div class="row">
          <% currentBookings.forEach(function(booking){ %>
          <div class="col-md-6 mb-4">
            <div class="card border-primary h-100 shadow-sm">
              <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-house-fill"></i> <%= booking.listing_title %></h5>
              </div>
              <div class="card-body">
                <p class="text-muted mb-2"><i class="bi bi-geo-alt"></i> <%= booking.listing_location %></p>
                <hr>
                <div class="row mb-3">
                  <div class="col-6">
                    <small class="text-muted d-block">Check-in</small>
                    <strong><%= new Date(booking.checkin).toLocaleDateString() %></strong><br>
                    <small><%= new Date(booking.checkin).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></small>
                  </div>
                  <div class="col-6">
                    <small class="text-muted d-block">Check-out</small>
                    <strong><%= new Date(booking.checkout).toLocaleDateString() %></strong><br>
                    <small><%= new Date(booking.checkout).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></small>
                  </div>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                  <div>
                    <small class="text-muted d-block">Total Amount</small>
                    <h4 class="text-success mb-0">$<%= booking.total_amount %></h4>
                  </div>
                  <span class="badge bg-success"><i class="bi bi-check-circle"></i> Confirmed</span>
                </div>
              </div>
              <div class="card-footer bg-light">
                <div class="d-flex gap-2">
                  <a href="/listing/<%= booking.listing_id %>" class="btn btn-outline-primary btn-sm flex-grow-1">
                    <i class="bi bi-eye"></i> View Property
                  </a>
                  <form method="POST" action="/dashboard/cancel-booking/<%= booking.id %>" onsubmit="return confirm('Are you sure you want to cancel this booking?');">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-outline-danger btn-sm">
                      <i class="bi bi-x-circle"></i> Cancel
                    </button>
                  </form>
                </div>
              </div>
            </div>
          </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="text-center py-5">
          <i class="bi bi-calendar-x" style="font-size: 4rem; color: #dee2e6;"></i>
          <h4 class="mt-3 text-muted">No Current Bookings</h4>
          <p class="text-muted">You don't have any active bookings at the moment.</p>
          <a href="/" class="btn btn-primary mt-2">
            <i class="bi bi-search"></i> Browse Properties
          </a>
        </div>
      <% } %>
    </div>

    <!-- Pending Bookings -->
    <div class="tab-pane fade" id="pending" role="tabpanel">
      <% if (pendingBookings && pendingBookings.length > 0) { %>
        <div class="alert alert-info">
          <i class="bi bi-info-circle"></i> These bookings are awaiting approval from the property host.
        </div>
        <div class="row">
          <% pendingBookings.forEach(function(booking){ %>
          <div class="col-md-6 mb-4">
            <div class="card border-warning h-100 shadow-sm">
              <div class="card-header bg-warning">
                <h5 class="mb-0"><i class="bi bi-house-fill"></i> <%= booking.listing_title %></h5>
              </div>
              <div class="card-body">
                <p class="text-muted mb-2"><i class="bi bi-geo-alt"></i> <%= booking.listing_location %></p>
                <hr>
                <div class="row mb-3">
                  <div class="col-6">
                    <small class="text-muted d-block">Check-in</small>
                    <strong><%= new Date(booking.checkin).toLocaleDateString() %></strong><br>
                    <small><%= new Date(booking.checkin).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></small>
                  </div>
                  <div class="col-6">
                    <small class="text-muted d-block">Check-out</small>
                    <strong><%= new Date(booking.checkout).toLocaleDateString() %></strong><br>
                    <small><%= new Date(booking.checkout).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></small>
                  </div>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                  <div>
                    <small class="text-muted d-block">Total Amount</small>
                    <h4 class="mb-0">$<%= booking.total_amount %></h4>
                  </div>
                  <span class="badge bg-warning"><i class="bi bi-clock-history"></i> Pending</span>
                </div>
              </div>
              <div class="card-footer bg-light">
                <a href="/listing/<%= booking.listing_id %>" class="btn btn-outline-primary btn-sm w-100">
                  <i class="bi bi-eye"></i> View Property
                </a>
              </div>
            </div>
          </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="text-center py-5">
          <i class="bi bi-clock-history" style="font-size: 4rem; color: #dee2e6;"></i>
          <h4 class="mt-3 text-muted">No Pending Bookings</h4>
          <p class="text-muted">You don't have any bookings awaiting approval.</p>
        </div>
      <% } %>
    </div>

    <!-- Previous Bookings -->
    <div class="tab-pane fade" id="previous" role="tabpanel">
      <% if (previousBookings && previousBookings.length > 0) { %>
        <div class="row">
          <% previousBookings.forEach(function(booking){ %>
          <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm">
              <div class="card-header bg-light">
                <h5 class="mb-0 text-muted"><i class="bi bi-house-fill"></i> <%= booking.listing_title %></h5>
              </div>
              <div class="card-body">
                <p class="text-muted mb-2"><i class="bi bi-geo-alt"></i> <%= booking.listing_location %></p>
                <hr>
                <div class="row mb-3">
                  <div class="col-6">
                    <small class="text-muted d-block">Check-in</small>
                    <strong><%= new Date(booking.checkin).toLocaleDateString() %></strong>
                  </div>
                  <div class="col-6">
                    <small class="text-muted d-block">Check-out</small>
                    <strong><%= new Date(booking.checkout).toLocaleDateString() %></strong>
                  </div>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                  <div>
                    <small class="text-muted d-block">Total Paid</small>
                    <h5 class="mb-0">$<%= booking.total_amount %></h5>
                  </div>
                  <span class="badge bg-secondary"><i class="bi bi-check-circle"></i> Completed</span>
                </div>
              </div>
              <div class="card-footer bg-light">
                <a href="/listing/<%= booking.listing_id %>" class="btn btn-outline-secondary btn-sm w-100">
                  <i class="bi bi-eye"></i> View Property
                </a>
              </div>
            </div>
          </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="text-center py-5">
          <i class="bi bi-calendar-check" style="font-size: 4rem; color: #dee2e6;"></i>
          <h4 class="mt-3 text-muted">No Previous Bookings</h4>
          <p class="text-muted">Your completed bookings will appear here.</p>
        </div>
      <% } %>
    </div>

  </div>
</div>

<style>
.card {
  transition: transform 0.2s, box-shadow 0.2s;
}
.card:hover {
  transform: translateY(-3px);
  box-shadow: 0 6px 20px rgba(0,0,0,0.15) !important;
}
</style>
