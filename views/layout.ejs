<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5, user-scalable=yes" />
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    
    <!-- SEO Meta Tags -->
    <title><%= (typeof title !== 'undefined') ? title + ' | Helnay - Premium Vacation Rentals' : 'Helnay - Find Your Perfect Vacation Rental Home' %></title>
    <meta name="description" content="<%= (typeof description !== 'undefined') ? description : 'Discover amazing vacation rental homes worldwide. Beach houses, city apartments, mountain retreats, and entire homes. Book your perfect stay with Helnay.' %>">
