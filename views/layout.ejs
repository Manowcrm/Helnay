    <meta name="author" content="Helnay">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="https://helnay.com<%= (typeof canonicalUrl !== 'undefined') ? canonicalUrl : '' %>">
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://helnay.com<%= (typeof canonicalUrl !== 'undefined') ? canonicalUrl : '' %>">
    <meta property="og:title" content="<%= (typeof title !== 'undefined') ? title + ' | Helnay' : 'Helnay - Premium Vacation Rentals' %>">
    <meta property="og:description" content="<%= (typeof description !== 'undefined') ? description : 'Discover amazing vacation rental homes worldwide. Book your perfect stay with Helnay.' %>">
    <meta property="og:image" content="https://helnay.com<%= (typeof ogImage !== 'undefined') ? ogImage : '/uploads/default-og-image.jpg' %>">
    <meta property="og:site_name" content="Helnay">
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="https://helnay.com<%= (typeof canonicalUrl !== 'undefined') ? canonicalUrl : '' %>">
    <meta name="twitter:title" content="<%= (typeof title !== 'undefined') ? title + ' | Helnay' : 'Helnay - Premium Vacation Rentals' %>">
    <meta name="twitter:description" content="<%= (typeof description !== 'undefined') ? description : 'Discover amazing vacation rental homes worldwide.' %>">
    <meta name="twitter:image" content="https://helnay.com<%= (typeof ogImage !== 'undefined') ? ogImage : '/uploads/default-og-image.jpg' %>">
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="https://img.icons8.com/fluency/48/home.png">
    <link rel="apple-touch-icon" sizes="180x180" href="https://img.icons8.com/fluency/96/home.png">
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,600;1,9..144,300&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/styles.css">
    
    <!-- Google Analytics -->
    <% if (process.env.GOOGLE_ANALYTICS_ID) { %>
    <script async src="https://www.googletagmanager.com/gtag/js?id=<%= process.env.GOOGLE_ANALYTICS_ID %>"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', '<%= process.env.GOOGLE_ANALYTICS_ID %>');
    </script>
    <% } %>
    
    <!-- Structured Data for SEO -->
    <% if (typeof structuredData !== 'undefined' && structuredData) { %>
    <script type="application/ld+json">
      <%- structuredData %>
    </script>
    <% } %>
  </head>
