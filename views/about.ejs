<!-- ABOUT HERO -->
<div class="about-hero text-white text-center">
  <div class="container py-5">
    <div class="hero-chip mx-auto mb-3"><i class="bi bi-info-circle-fill"></i> Our Story</div>
    <h1 class="display-4 fw-bold mb-3" style="font-family:'Fraunces',serif;letter-spacing:-1px">About Helnay</h1>
    <p class="lead mb-4" style="color:rgba(255,255,255,0.75);max-width:500px;margin:0 auto 28px">Kenya & Somalia's trusted rental platform — built for East Africa, by East Africans.</p>
    <div class="d-flex gap-3 justify-content-center flex-wrap">
      <a href="/" class="btn btn-light btn-lg px-4 fw-700" style="border-radius:100px;font-weight:700;color:var(--g1)"><i class="bi bi-house-door"></i> Browse Properties</a>
      <a href="/contact" class="btn btn-outline-light btn-lg px-4" style="border-radius:100px;border-color:rgba(255,255,255,0.5)"><i class="bi bi-envelope"></i> Contact Us</a>
    </div>
  </div>
</div>

<!-- STATS STRIP -->
<div class="bg-white border-bottom" style="border-color:var(--border)!important">
  <div class="container py-4">
    <div class="row g-3 text-center">
      <div class="col-6 col-md-3">
        <div class="stat-num">500+</div>
        <div class="text-muted small">Properties Listed</div>
      </div>
      <div class="col-6 col-md-3">
        <div class="stat-num">10K+</div>
        <div class="text-muted small">Happy Guests</div>
      </div>
      <div class="col-6 col-md-3">
        <div class="stat-num">4.9★</div>
        <div class="text-muted small">Average Rating</div>
      </div>
      <div class="col-6 col-md-3">
        <div class="stat-num">6+</div>
        <div class="text-muted small">Cities Covered</div>
      </div>
    </div>
  </div>
</div>

<!-- OUR STORY -->
<div class="container my-5 py-3">
  <div class="row align-items-center g-5">
    <div class="col-lg-6">
      <img src="https://images.unsplash.com/photo-1560518883-ce09059eeffa?w=700&q=80&auto=format&fit=crop"
           alt="Beautiful home in Nairobi"
           class="img-fluid w-100"
           style="height:420px;object-fit:cover;border-radius:20px;">
    </div>
    <div class="col-lg-6">
      <div class="hero-chip mb-3"><i class="bi bi-book-fill"></i> Our Story</div>
      <h2 style="font-family:'Fraunces',serif;font-size:2rem;font-weight:600;letter-spacing:-0.5px" class="mb-3">Built for East Africa</h2>
      <p class="text-muted mb-3" style="font-size:15px;line-height:1.8">
        Helnay was founded with a simple mission: make renting a home in Kenya and Somalia as easy, safe, and trustworthy as possible. We saw that existing platforms were built for Western markets — no M-Pesa support, no local context, no understanding of how East Africans rent.
      </p>
      <p class="text-muted" style="font-size:15px;line-height:1.8">
        We built Helnay to fix that. Every feature — from our M-Pesa payment flow to our verified host badges and escrow protection — is designed specifically for our market.
      </p>
      <div class="d-flex gap-3 mt-4 flex-wrap">
        <div class="px-4 py-3 rounded-3 text-center" style="background:#edf7f2;border:1px solid rgba(45,106,79,0.15)">
          <div style="font-family:'Fraunces',serif;font-size:1.5rem;font-weight:600;color:var(--g1)">KES</div>
          <div class="small text-muted">Local Currency</div>
        </div>
        <div class="px-4 py-3 rounded-3 text-center" style="background:#edf7f2;border:1px solid rgba(45,106,79,0.15)">
          <div style="font-family:'Fraunces',serif;font-size:1.5rem;font-weight:600;color:var(--g1)">M-Pesa</div>
          <div class="small text-muted">Payments</div>
        </div>
        <div class="px-4 py-3 rounded-3 text-center" style="background:#edf7f2;border:1px solid rgba(45,106,79,0.15)">
          <div style="font-family:'Fraunces',serif;font-size:1.5rem;font-weight:600;color:var(--g1)">3%</div>
          <div class="small text-muted">Commission Only</div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- WHY CHOOSE US -->
<div style="background:#f8f7f4;padding:60px 0">
  <div class="container">
    <div class="text-center mb-5">
      <div class="hero-chip mx-auto mb-3"><i class="bi bi-star-fill"></i> Why Helnay</div>
      <h2 style="font-family:'Fraunces',serif;font-size:2rem;font-weight:600;letter-spacing:-0.5px">Why Choose Helnay?</h2>
      <p class="text-muted">Everything built for the East African rental market</p>
    </div>
    <div class="row g-4">
      <% const features = [
        {icon:'shield-check', title:'Verified Properties', desc:'Every landlord is ID-verified and every listing is reviewed by our team before going live.'},
        {icon:'phone-fill', title:'M-Pesa Payments', desc:'Pay and get paid via M-Pesa STK Push. No credit card needed, no foreign transaction fees.'},
        {icon:'clock-history', title:'24/7 Support', desc:'Our Kenya-based support team is available round the clock via WhatsApp and phone.'},
        {icon:'search-heart', title:'Local Search', desc:'Search by Nairobi neighbourhood, Mombasa beach area, or any Kenyan and Somali city.'},
        {icon:'calendar-check', title:'Instant Booking', desc:'Confirm your booking in minutes with our instant M-Pesa confirmation system.'},
        {icon:'lock-fill', title:'Escrow Protection', desc:'Your payment is held securely until you check in. Full refund if anything is misrepresented.'}
      ]; %>
      <% features.forEach(function(f){ %>
      <div class="col-md-4">
        <div class="why-card h-100">
          <div class="why-icon"><i class="bi bi-<%= f.icon %>"></i></div>
          <h5 class="fw-700 mb-2" style="font-weight:700"><%= f.title %></h5>
          <p class="text-muted small mb-0" style="line-height:1.7"><%= f.desc %></p>
        </div>
      </div>
      <% }); %>
    </div>
  </div>
</div>

<!-- MISSION & VISION -->
<div class="container my-5 py-3">
  <div class="row g-4">
    <div class="col-lg-6">
      <div class="h-100 p-5 rounded-4" style="background:linear-gradient(135deg,#0d2e1e,#1a4731);color:#fff">
        <div style="width:48px;height:48px;background:rgba(244,162,97,0.2);border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:22px;color:#f4a261;margin-bottom:16px">
          <i class="bi bi-bullseye"></i>
        </div>
        <h3 style="font-family:'Fraunces',serif;font-weight:600;margin-bottom:12px">Our Mission</h3>
        <p style="color:rgba(255,255,255,0.72);line-height:1.8;font-size:14.5px">
          To make renting in East Africa safe, simple, and fair — for both tenants and landlords. We connect people with quality homes using technology built for our local context, not imported from abroad.
        </p>
      </div>
    </div>
    <div class="col-lg-6">
      <div class="h-100 p-5 rounded-4" style="background:linear-gradient(135deg,#edfaf3,#c8eada);border:1px solid rgba(45,106,79,0.15)">
        <div style="width:48px;height:48px;background:rgba(45,106,79,0.15);border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:22px;color:var(--g1);margin-bottom:16px">
          <i class="bi bi-eye-fill"></i>
        </div>
        <h3 style="font-family:'Fraunces',serif;font-weight:600;color:var(--g1);margin-bottom:12px">Our Vision</h3>
        <p style="color:var(--muted);line-height:1.8;font-size:14.5px">
          To be the #1 rental platform across all of East Africa — trusted by millions of tenants and thousands of landlords from Nairobi to Mogadishu, with M-Pesa at the heart of every transaction.
        </p>
      </div>
    </div>
  </div>
</div>

<!-- CTA -->
<div style="background:linear-gradient(135deg,#0d2e1e,#2d6a4f);padding:60px 0;margin-top:20px">
  <div class="container text-center text-white">
    <h2 style="font-family:'Fraunces',serif;font-size:2rem;font-weight:600;margin-bottom:10px">Ready to Find Your Perfect Stay?</h2>
    <p style="color:rgba(255,255,255,0.7);margin-bottom:28px">Explore verified properties across Kenya and Somalia</p>
    <div class="d-flex gap-3 justify-content-center flex-wrap">
      <a href="/" class="btn btn-light btn-lg px-5" style="border-radius:100px;font-weight:700;color:var(--g1)"><i class="bi bi-search"></i> Browse Properties</a>
      <a href="/contact" class="btn btn-outline-light btn-lg px-5" style="border-radius:100px;border-color:rgba(255,255,255,0.45)"><i class="bi bi-question-circle"></i> Get in Touch</a>
    </div>
  </div>
</div>
