<!-- Hero Section -->
<div class="hero-banner text-white text-center position-relative" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 4rem 0 3rem;">
  <div class="container">
    <h1 class="display-4 fw-bold mb-3">
      <i class="bi bi-building me-2"></i>Premium Hotels Worldwide
    </h1>
    <p class="lead mb-4">Book your perfect hotel stay with confidence</p>
    
    <!-- Search Box -->
    <div class="search-container mx-auto" style="max-width: 700px;">
      <form action="/hotels" method="GET" class="bg-white rounded-4 p-3 shadow-lg">
        <div class="row g-2 align-items-end">
          <div class="col-md-4">
            <label class="form-label text-dark small mb-1">Location</label>
            <input type="text" name="location" class="form-control border-0 bg-light" 
                   placeholder="Where are you going?" value="<%= query.location || '' %>">
          </div>
          <div class="col-md-3">
            <label class="form-label text-dark small mb-1">Bedrooms</label>
            <select name="bedrooms" class="form-select border-0 bg-light">
              <option value="">Any</option>
              <option value="1" <%= query.bedrooms === '1' ? 'selected' : '' %>>1+</option>
              <option value="2" <%= query.bedrooms === '2' ? 'selected' : '' %>>2+</option>
              <option value="3" <%= query.bedrooms === '3' ? 'selected' : '' %>>3+</option>
              <option value="4" <%= query.bedrooms === '4' ? 'selected' : '' %>>4+</option>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label text-dark small mb-1">Guests</label>
            <select name="guests" class="form-select border-0 bg-light">
              <option value="">Any</option>
              <option value="1" <%= query.guests === '1' ? 'selected' : '' %>>1+</option>
              <option value="2" <%= query.guests === '2' ? 'selected' : '' %>>2+</option>
              <option value="4" <%= query.guests === '4' ? 'selected' : '' %>>4+</option>
              <option value="6" <%= query.guests === '6' ? 'selected' : '' %>>6+</option>
            </select>
          </div>
          <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100 fw-semibold py-2">
              <i class="bi bi-search me-1"></i>Search
            </button>
          </div>
        </div>
        
        <!-- Advanced Filters (collapsible) -->
        <div class="mt-2">
          <button class="btn btn-link text-decoration-none text-dark p-0 small" type="button" 
                  data-bs-toggle="collapse" data-bs-target="#advancedFilters">
            <i class="bi bi-sliders"></i> More filters
          </button>
        </div>
        
        <div class="collapse mt-2" id="advancedFilters">
          <div class="row g-2">
            <div class="col-md-6">
              <label class="form-label text-dark small mb-1">Min Price ($/night)</label>
              <input type="number" name="min_price" class="form-control border-0 bg-light" 
                     placeholder="0" value="<%= query.min_price || '' %>">
            </div>
            <div class="col-md-6">
              <label class="form-label text-dark small mb-1">Max Price ($/night)</label>
              <input type="number" name="max_price" class="form-control border-0 bg-light" 
                     placeholder="1000" value="<%= query.max_price || '' %>">
            </div>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Listings Section -->
<div class="container my-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="h4 mb-1">Available Hotels</h2>
      <p class="text-muted mb-0"><%= listings.length %> properties found</p>
    </div>
    
    <!-- Sort Options -->
    <div class="dropdown">
      <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
        <i class="bi bi-sort-down"></i> Sort by
      </button>
      <ul class="dropdown-menu">
        <li><a class="dropdown-item" href="/hotels?sort=newest<%= query.location ? '&location=' + query.location : '' %><%= query.min_price ? '&min_price=' + query.min_price : '' %><%= query.max_price ? '&max_price=' + query.max_price : '' %><%= query.bedrooms ? '&bedrooms=' + query.bedrooms : '' %><%= query.guests ? '&guests=' + query.guests : '' %>">Newest First</a></li>
        <li><a class="dropdown-item" href="/hotels?sort=price_low<%= query.location ? '&location=' + query.location : '' %><%= query.min_price ? '&min_price=' + query.min_price : '' %><%= query.max_price ? '&max_price=' + query.max_price : '' %><%= query.bedrooms ? '&bedrooms=' + query.bedrooms : '' %><%= query.guests ? '&guests=' + query.guests : '' %>">Price: Low to High</a></li>
        <li><a class="dropdown-item" href="/hotels?sort=price_high<%= query.location ? '&location=' + query.location : '' %><%= query.min_price ? '&min_price=' + query.min_price : '' %><%= query.max_price ? '&max_price=' + query.max_price : '' %><%= query.bedrooms ? '&bedrooms=' + query.bedrooms : '' %><%= query.guests ? '&guests=' + query.guests : '' %>">Price: High to Low</a></li>
      </ul>
    </div>
  </div>
  
  <% if (listings.length === 0) { %>
    <div class="text-center py-5">
      <i class="bi bi-building display-1 text-muted"></i>
      <h3 class="mt-3">No hotels found</h3>
      <p class="text-muted">Try adjusting your search filters</p>
      <a href="/hotels" class="btn btn-primary">Clear Filters</a>
    </div>
  <% } else { %>
    <div class="row g-4">
      <% listings.forEach(listing => { %>
        <div class="col-md-6 col-lg-4">
          <div class="card h-100 border-0 shadow-sm listing-card">
            <div class="position-relative">
              <img src="<%= listing.image_url || '/uploads/placeholder.jpg' %>" 
                   class="card-img-top" alt="<%= listing.title %>" 
                   style="height: 250px; object-fit: cover;">
              
              <% if (user) { %>
                <form method="POST" action="<%= favoriteIds.includes(listing.id) ? '/favorites/remove' : '/favorites/add' %>" 
                      class="favorite-form position-absolute top-0 end-0 m-2">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="listing_id" value="<%= listing.id %>">
                  <button type="submit" class="btn btn-light btn-sm rounded-circle shadow-sm" 
                          style="width: 36px; height: 36px;">
                    <i class="bi bi-heart<%= favoriteIds.includes(listing.id) ? '-fill text-danger' : '' %>"></i>
                  </button>
                </form>
              <% } %>
            </div>
            
            <div class="card-body">
              <h5 class="card-title mb-2">
                <a href="/listing/<%= listing.id %>" class="text-decoration-none text-dark">
                  <%= listing.title %>
                </a>
              </h5>
              
              <p class="text-muted small mb-2">
                <i class="bi bi-geo-alt"></i> <%= listing.location_name || listing.location || 'Location not specified' %>
              </p>
              
              <div class="d-flex gap-3 text-muted small mb-2">
                <% if (listing.bedrooms) { %>
                  <span><i class="bi bi-door-closed"></i> <%= listing.bedrooms %> beds</span>
                <% } %>
                <% if (listing.max_guests) { %>
                  <span><i class="bi bi-people"></i> <%= listing.max_guests %> guests</span>
                <% } %>
              </div>
              
              <div class="d-flex justify-content-between align-items-center mt-3">
                <div>
                  <strong class="h5 mb-0 text-primary">$<%= listing.price %></strong>
                  <small class="text-muted">/night</small>
                </div>
                <a href="/listing/<%= listing.id %>" class="btn btn-outline-primary btn-sm">View Details</a>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>

<style>
.listing-card {
  transition: transform 0.2s, box-shadow 0.2s;
}
.listing-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.15) !important;
}
.favorite-form button {
  backdrop-filter: blur(10px);
}
</style>

<script>
// Auto-submit favorite forms
document.querySelectorAll('.favorite-form').forEach(form => {
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const response = await fetch(form.action, {
      method: 'POST',
      body: formData
    });
    if (response.ok) {
      location.reload();
    }
  });
});
</script>
