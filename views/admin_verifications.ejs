<div class="container mt-4">
  <h1 class="mb-4"><i class="bi bi-shield-check"></i> User Verifications</h1>
  
  <!-- Filter Info -->
  <% if (filter) { %>
  <div class="alert alert-info alert-dismissible fade show" role="alert">
    <i class="bi bi-funnel"></i> <strong>Filtered:</strong> Showing <%= 
      filter === 'email_verified' ? 'Email Verified Users' :
      filter === 'phone_verified' ? 'Phone Verified Users' :
      filter === 'id_verified' ? 'ID Verified Users' :
      filter === 'pending' ? 'Pending ID Verifications' :
      filter === 'not_submitted' ? 'Not Submitted ID' : 'All Users'
    %>
    <a href="/admin/verifications" class="btn btn-sm btn-outline-primary ms-2">Clear Filter</a>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
  <% } %>

  <!-- Statistics Cards (Clickable) -->
  <div class="row mb-4">
    <div class="col-md-3">
      <a href="/admin/verifications?filter=email_verified" class="text-decoration-none">
        <div class="card bg-primary text-white <%= filter === 'email_verified' ? 'border border-dark border-3' : '' %>" style="cursor: pointer; transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">
          <div class="card-body">
            <h6 class="card-title"><i class="bi bi-envelope-check"></i> Email Verified</h6>
            <h2><%= stats.email_verified %></h2>
          </div>
        </div>
      </a>
    </div>
    <div class="col-md-3">
      <a href="/admin/verifications?filter=phone_verified" class="text-decoration-none">
        <div class="card bg-success text-white <%= filter === 'phone_verified' ? 'border border-dark border-3' : '' %>" style="cursor: pointer; transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">
          <div class="card-body">
            <h6 class="card-title"><i class="bi bi-phone-fill"></i> Phone Verified</h6>
            <h2><%= stats.phone_verified %></h2>
          </div>
        </div>
      </a>
    </div>
    <div class="col-md-3">
      <a href="/admin/verifications?filter=id_verified" class="text-decoration-none">
        <div class="card bg-info text-white <%= filter === 'id_verified' ? 'border border-dark border-3' : '' %>" style="cursor: pointer; transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">
          <div class="card-body">
            <h6 class="card-title"><i class="bi bi-card-heading"></i> ID Verified</h6>
            <h2><%= stats.id_verified %></h2>
          </div>
        </div>
      </a>
    </div>
    <div class="col-md-3">
      <a href="/admin/verifications?filter=pending" class="text-decoration-none">
        <div class="card bg-warning text-white <%= filter === 'pending' ? 'border border-dark border-3' : '' %>" style="cursor: pointer; transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">
          <div class="card-body">
            <h6 class="card-title"><i class="bi bi-hourglass-split"></i> Pending Review</h6>
            <h2><%= stats.pending_review %></h2>
          </div>
        </div>
      </a>
    </div>
  </div>

  <!-- Pending ID Verifications -->
  <% if (pending && pending.length > 0) { %>
  <div class="card mb-4">
    <div class="card-header bg-warning">
      <h5 class="mb-0"><i class="bi bi-clock-history"></i> Pending ID Verifications (<%= pending.length %>)</h5>
    </div>
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-hover">
          <thead>
            <tr>
              <th>User</th>
              <th>Email</th>
              <th>Phone</th>
              <th>Document Type</th>
              <th>Submitted</th>
              <th>Documents</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% pending.forEach(function(item){ %>
            <tr>
              <td><strong><%= item.name %></strong></td>
              <td><%= item.email %></td>
              <td>
                <% if (item.phone_verified) { %>
                  <span class="badge bg-success"><i class="bi bi-check-circle"></i> <%= item.phone_number || 'N/A' %></span>
                <% } else { %>
                  <span class="badge bg-secondary">Not verified</span>
                <% } %>
              </td>
              <td><span class="badge bg-primary"><%= item.id_document_type || 'Not specified' %></span></td>
              <td>
                <%= item.created_at ? new Date(item.created_at).toLocaleDateString() : 'N/A' %>
                <small class="text-muted d-block">
                  <%= item.created_at ? new Date(item.created_at).toLocaleTimeString() : '' %>
                </small>
              </td>
              <td>
                <% if (item.id_document_url) { %>
                  <a href="<%= item.id_document_url %>" target="_blank" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-file-earmark-image"></i> View ID
                  </a>
                <% } %>
                <% if (item.id_selfie_url) { %>
                  <a href="<%= item.id_selfie_url %>" target="_blank" class="btn btn-sm btn-outline-info">
                    <i class="bi bi-person-badge"></i> View Selfie
                  </a>
                <% } %>
              </td>
              <td>
                <form method="POST" action="/admin/verify-id/<%= item.user_id %>/approve" style="display:inline;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-sm btn-success">
                    <i class="bi bi-check-circle"></i> Approve
                  </button>
                </form>
                <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#rejectModal<%= item.user_id %>">
                  <i class="bi bi-x-circle"></i> Reject
                </button>
                
                <!-- Reject Modal -->
                <div class="modal fade" id="rejectModal<%= item.user_id %>" tabindex="-1">
                  <div class="modal-dialog">
                    <div class="modal-content">
                      <div class="modal-header">
                        <h5 class="modal-title">Reject ID Verification</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                      </div>
                      <form method="POST" action="/admin/verify-id/<%= item.user_id %>/reject">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="modal-body">
                          <p>User: <strong><%= item.name %></strong> (<%= item.email %>)</p>
                          <div class="mb-3">
                            <label class="form-label">Rejection Reason</label>
                            <select class="form-select" name="reason" required>
                              <option value="">Select reason...</option>
                              <option value="Document not clear">Document not clear/readable</option>
                              <option value="Document expired">Document expired</option>
                              <option value="Document type not accepted">Document type not accepted</option>
                              <option value="Name mismatch">Name doesn't match account</option>
                              <option value="Photo mismatch">Selfie doesn't match ID photo</option>
                              <option value="Suspected fraud">Suspected fraud/fake document</option>
                              <option value="Other">Other (specify below)</option>
                            </select>
                          </div>
                          <div class="mb-3">
                            <label class="form-label">Additional Notes</label>
                            <textarea class="form-control" name="notes" rows="3" placeholder="Optional additional information..."></textarea>
                          </div>
                        </div>
                        <div class="modal-footer">
                          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                          <button type="submit" class="btn btn-danger">Reject Verification</button>
                        </div>
                      </form>
                    </div>
                  </div>
                </div>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <% } else { %>
  <div class="alert alert-info">
    <i class="bi bi-info-circle"></i> No pending ID verifications to review.
  </div>
  <% } %>

  <!-- All Users Verification Status -->
  <div class="card">
    <div class="card-header">
      <h5 class="mb-0">
        <i class="bi bi-people"></i> 
        <%= filter ? 'Filtered Users' : 'All Users Verification Status' %>
        <span class="badge bg-secondary ms-2"><%= displayedUsers %> <%= filter ? 'matching' : 'total' %></span>
      </h5>
    </div>
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-striped table-hover">
          <thead class="table-dark">
            <tr>
              <th>User</th>
              <th>Email</th>
              <th>Phone</th>
              <th>Email</th>
              <th>Phone</th>
              <th>ID</th>
              <th>Trust Score</th>
              <th>Registered</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(function(u){ %>
            <tr>
              <td><strong><%= u.name %></strong></td>
              <td><%= u.email %></td>
              <td><%= u.phone_number || '-' %></td>
              <td>
                <% if (u.is_verified) { %>
                  <span class="badge bg-success"><i class="bi bi-check-circle"></i></span>
                <% } else { %>
                  <span class="badge bg-danger"><i class="bi bi-x-circle"></i></span>
                <% } %>
              </td>
              <td>
                <% if (u.phone_verified) { %>
                  <span class="badge bg-success"><i class="bi bi-check-circle"></i></span>
                <% } else { %>
                  <span class="badge bg-secondary"><i class="bi bi-dash-circle"></i></span>
                <% } %>
              </td>
              <td>
                <% if (u.id_verified) { %>
                  <span class="badge bg-success"><i class="bi bi-shield-check"></i> Verified</span>
                <% } else if (u.id_document_url || u.v_id_verified !== null) { %>
                  <span class="badge bg-warning"><i class="bi bi-hourglass-split"></i> Pending</span>
                <% } else { %>
                  <span class="badge bg-secondary"><i class="bi bi-dash-circle"></i> Not submitted</span>
                <% } %>
              </td>
              <td>
                <% 
                  let score = 0;
                  if (u.is_verified) score += 25;
                  if (u.phone_verified) score += 25;
                  if (u.id_verified) score += 50;
                  let scoreClass = score >= 75 ? 'success' : score >= 50 ? 'warning' : 'danger';
                %>
                <span class="badge bg-<%= scoreClass %>"><%= score %>%</span>
              </td>
              <td>
                <%= u.created_at ? new Date(u.created_at).toLocaleDateString() : 'N/A' %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
