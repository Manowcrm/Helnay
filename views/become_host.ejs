<!-- HERO -->
<div class="host-page-hero text-white text-center">
  <div class="container py-5">
    <div class="hero-chip mx-auto mb-3" style="background:rgba(244,162,97,0.2);border-color:rgba(244,162,97,0.4);color:#fcd4a0"><i class="bi bi-house-add-fill"></i> For Landlords</div>
    <h1 class="fw-bold mb-3">Earn Money from Your Property</h1>
    <p class="lead mb-4" style="color:rgba(255,255,255,0.72);max-width:480px;margin:0 auto 28px">Join Helnay and start earning from your apartment, house, or villa. M-Pesa payouts, just 3% commission.</p>
    <a href="#calculator" class="btn btn-light btn-lg px-5" style="border-radius:100px;font-weight:700;color:var(--g1)"><i class="bi bi-calculator"></i> Calculate Earnings</a>
  </div>
</div>

<!-- WHY HOST -->
<div class="container my-5">
  <div class="text-center mb-4">
    <h2 style="font-family:'Fraunces',serif;font-size:1.8rem;font-weight:600;letter-spacing:-0.4px">Why List on Helnay?</h2>
    <p class="text-muted">Everything designed for East African landlords</p>
  </div>
  <div class="row g-4">
    <div class="col-md-4"><div class="why-card h-100"><div class="why-icon"><i class="bi bi-percent"></i></div><h5 class="fw-bold mb-2">Only 3% Commission</h5><p class="text-muted small mb-0" style="line-height:1.7">Keep 97% of every booking. Far lower than any other platform in the market.</p></div></div>
    <div class="col-md-4"><div class="why-card h-100"><div class="why-icon"><i class="bi bi-phone-fill"></i></div><h5 class="fw-bold mb-2">M-Pesa Payouts</h5><p class="text-muted small mb-0" style="line-height:1.7">Receive earnings directly to your M-Pesa within 24 hours of each guest check-in.</p></div></div>
    <div class="col-md-4"><div class="why-card h-100"><div class="why-icon"><i class="bi bi-shield-check"></i></div><h5 class="fw-bold mb-2">Verified Guests Only</h5><p class="text-muted small mb-0" style="line-height:1.7">Every guest is ID-verified before booking. Your property is always protected.</p></div></div>
    <div class="col-md-4"><div class="why-card h-100"><div class="why-icon"><i class="bi bi-graph-up-arrow"></i></div><h5 class="fw-bold mb-2">Smart Pricing Tools</h5><p class="text-muted small mb-0" style="line-height:1.7">Our dashboard shows you market rates so you always price competitively.</p></div></div>
    <div class="col-md-4"><div class="why-card h-100"><div class="why-icon"><i class="bi bi-headset"></i></div><h5 class="fw-bold mb-2">24/7 Host Support</h5><p class="text-muted small mb-0" style="line-height:1.7">Dedicated WhatsApp support line for hosts — in English, Swahili and Somali.</p></div></div>
    <div class="col-md-4"><div class="why-card h-100"><div class="why-icon"><i class="bi bi-rocket-takeoff"></i></div><h5 class="fw-bold mb-2">Live in Under 24h</h5><p class="text-muted small mb-0" style="line-height:1.7">Submit your listing and go live within 24 hours after our quick verification.</p></div></div>
  </div>
</div>

<!-- EARNINGS CALCULATOR -->
<div style="background:#f8f7f4;padding:60px 0" id="calculator">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="earnings-calc">
          <div class="text-center mb-4">
            <h2 class="mb-1">Earnings Calculator</h2>
            <p class="text-muted small">Estimate your potential monthly income from your property</p>
          </div>
          <div class="row g-4 align-items-end">
            <div class="col-md-7">
              <div class="mb-4">
                <label class="form-label fw-bold small text-uppercase" style="letter-spacing:.4px;color:var(--hint)">Nightly Rate (KES)</label>
                <input type="number" class="form-control form-control-lg" id="nightlyRate" value="8000" min="1" style="border-radius:12px">
              </div>
              <div class="mb-3">
                <label class="form-label fw-bold small text-uppercase d-flex justify-content-between" style="letter-spacing:.4px;color:var(--hint)">
                  <span>Nights Booked / Month</span>
                  <span style="color:var(--g1)" id="nightsValue">20 nights</span>
                </label>
                <input type="range" class="form-range" id="nightsBooked" min="1" max="30" value="20" style="accent-color:var(--g1)">
                <div class="d-flex justify-content-between"><small class="text-muted">1</small><small class="text-muted">30</small></div>
              </div>
            </div>
            <div class="col-md-5">
              <div class="calc-result-box">
                <div class="small fw-bold text-uppercase mb-1" style="letter-spacing:.5px;color:var(--g2)">Est. Monthly Earnings</div>
                <div class="calc-result-num" id="earnings">KES 155,520</div>
                <div class="small mt-1" style="color:var(--g2)">After 3% Helnay fee</div>
              </div>
            </div>
          </div>
          <div class="alert alert-info mt-3 small" style="border-radius:12px">
            <i class="bi bi-info-circle me-1"></i> Estimate only. Actual earnings depend on location, season, and occupancy.
          </div>
          <div class="text-center mt-3">
            <a href="#get-started" class="btn btn-primary btn-lg px-5" style="border-radius:100px">Start Listing Now →</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- HOW IT WORKS -->
<div class="container my-5 py-3">
  <div class="text-center mb-5">
    <h2 style="font-family:'Fraunces',serif;font-size:1.8rem;font-weight:600;letter-spacing:-0.4px">How It Works</h2>
  </div>
  <div class="row g-4 text-center">
    <% const steps = [
      {num:'1',icon:'camera-fill',title:'List Your Property',desc:'Add photos, description, amenities and set your nightly rate in KES.'},
      {num:'2',icon:'shield-check',title:'Get Verified',desc:'Our team reviews your listing and verifies your identity within 24 hours.'},
      {num:'3',icon:'calendar-check',title:'Receive Bookings',desc:'Guests find and book your property. You get instant M-Pesa notification.'},
      {num:'4',icon:'phone-fill',title:'Get Paid',desc:'Payment hits your M-Pesa within 24 hours of guest check-in. Every time.'}
    ]; %>
    <% steps.forEach(function(s){ %>
    <div class="col-md-3">
      <div class="p-4 rounded-4 h-100" style="background:#fff;border:1px solid var(--border)">
        <div class="mx-auto mb-3 d-flex align-items-center justify-content-center" style="width:52px;height:52px;background:linear-gradient(135deg,#1a4731,#2d6a4f);border-radius:50%;color:#fff;font-size:1.1rem;font-weight:800"><%= s.num %></div>
        <i class="bi bi-<%= s.icon %> mb-2" style="font-size:1.6rem;color:var(--g2);display:block"></i>
        <h6 class="fw-bold mb-2"><%= s.title %></h6>
        <p class="text-muted small mb-0" style="line-height:1.7"><%= s.desc %></p>
      </div>
    </div>
    <% }); %>
  </div>
</div>

<!-- LIST FORM -->
<div style="background:#f8f7f4;padding:60px 0" id="get-started">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="become-host-form">
          <h2 class="mb-1">List Your Property</h2>
          <p class="text-muted small mb-4">Takes 5 minutes · Go live within 24 hours</p>
          <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger" style="border-radius:12px"><%= error %></div>
          <% } %>
          <% if (typeof message !== 'undefined' && message) { %>
            <div class="alert alert-success" style="border-radius:12px"><%= message %></div>
          <% } %>
          <form method="POST" action="/become-a-host" enctype="multipart/form-data">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="mb-4">
              <label class="form-label fw-bold small text-uppercase" style="letter-spacing:.4px;color:var(--hint)">Property Type</label>
              <div class="row g-2">
                <% const types = [{val:'apartment',icon:'building',label:'Apartment'},{val:'house',icon:'house-fill',label:'House'},{val:'villa',icon:'gem',label:'Villa'},{val:'studio',icon:'door-closed',label:'Studio'}]; %>
                <% types.forEach(function(t){ %>
                <div class="col-6 col-md-3">
                  <label class="type-option w-100" style="cursor:pointer">
                    <input type="radio" name="property_type" value="<%= t.val %>" style="display:none" onchange="this.closest('.row').querySelectorAll('.type-option').forEach(el=>el.classList.remove('selected'));this.closest('.type-option').classList.add('selected')">
                    <i class="bi bi-<%= t.icon %>" style="font-size:1.5rem;display:block;margin-bottom:5px"></i>
                    <span style="font-size:12px;font-weight:700"><%= t.label %></span>
                  </label>
                </div>
                <% }); %>
              </div>
            </div>
            <div class="row g-3 mb-3">
              <div class="col-md-6"><label class="form-label fw-bold small" style="color:var(--hint)">Property Name</label><input type="text" name="title" class="form-control" placeholder="e.g. Cozy Apt in Kilimani" required style="border-radius:10px"></div>
              <div class="col-md-6"><label class="form-label fw-bold small" style="color:var(--hint)">City</label>
                <select name="location" class="form-select" style="border-radius:10px">
                  <option value="Nairobi">Nairobi</option>
                  <option value="Mombasa">Mombasa</option>
                  <option value="Kisumu">Kisumu</option>
                  <option value="Nakuru">Nakuru</option>
                  <option value="Mogadishu">Mogadishu</option>
                  <option value="Hargeisa">Hargeisa</option>
                  <option value="Other">Other</option>
                </select>
              </div>
            </div>
            <div class="row g-3 mb-3">
              <div class="col-md-6"><label class="form-label fw-bold small" style="color:var(--hint)">Neighbourhood</label><input type="text" name="neighbourhood" class="form-control" placeholder="e.g. Westlands, Kilimani" style="border-radius:10px"></div>
              <div class="col-md-6"><label class="form-label fw-bold small" style="color:var(--hint)">Nightly Rate (KES)</label><input type="number" name="price" class="form-control" placeholder="e.g. 7500" required style="border-radius:10px"></div>
            </div>
            <div class="mb-3"><label class="form-label fw-bold small" style="color:var(--hint)">Description</label><textarea name="description" class="form-control" rows="3" placeholder="Describe your property, location highlights, and what makes it special…" style="border-radius:10px"></textarea></div>
            <div class="mb-3"><label class="form-label fw-bold small" style="color:var(--hint)">M-Pesa Number for Payouts</label><input type="tel" name="mpesa_number" class="form-control" placeholder="+254 700 000 000" style="border-radius:10px"></div>
            <div class="mb-4"><label class="form-label fw-bold small" style="color:var(--hint)">Property Photos</label><input type="file" name="images" class="form-control" multiple accept="image/*" style="border-radius:10px"></div>
            <button type="submit" class="btn-submit-host btn btn-primary w-100">Submit for Review →</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
const rateEl = document.getElementById('nightlyRate');
const nightsEl = document.getElementById('nightsBooked');
const nightsVal = document.getElementById('nightsValue');
const earningsEl = document.getElementById('earnings');
function updateCalc() {
  const r = parseInt(rateEl.value)||0;
  const n = parseInt(nightsEl.value)||0;
  nightsVal.textContent = n + ' nights';
  earningsEl.textContent = 'KES ' + Math.round(r * n * 0.97).toLocaleString();
}
rateEl.addEventListener('input', updateCalc);
nightsEl.addEventListener('input', updateCalc);
</script>
