<!-- Earnings Calculator -->
<div class="bg-light py-5" id="calculator">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="card shadow border-0">
          <div class="card-body p-5">
            <h2 class="text-center mb-4">💰 Earnings Calculator</h2>
            <p class="text-center text-muted mb-4">Estimate your potential monthly income</p>
            
            <div class="mb-4">
              <label class="form-label fw-bold">Nightly Rate ($)</label>
              <input type="number" class="form-control form-control-lg" id="nightlyRate" value="150" min="1">
            </div>
            
            <div class="mb-4">
              <label class="form-label fw-bold">Nights Booked per Month</label>
              <input type="range" class="form-range" id="nightsBooked" min="1" max="30" value="15">
              <div class="d-flex justify-content-between">
                <small class="text-muted">1 night</small>
                <strong id="nightsValue">15 nights</strong>
                <small class="text-muted">30 nights</small>
              </div>
            </div>
            
            <div class="alert alert-success">
              <div class="row align-items-center">
                <div class="col-md-6">
                  <h5 class="mb-0">Estimated Monthly Earnings</h5>
                </div>
                <div class="col-md-6 text-end">
                  <h2 class="mb-0 text-success" id="earnings">$2,250</h2>
                </div>
              </div>
            </div>
            
            <div class="alert alert-info">
              <small>
                <i class="bi bi-info-circle"></i> This is an estimate. Actual earnings depend on location, property type, seasonality, and occupancy rates.
              </small>
            </div>
            
            <div class="text-center mt-4">
              <a href="#get-started" class="btn btn-primary btn-lg px-5 py-3">Start Listing Now</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

