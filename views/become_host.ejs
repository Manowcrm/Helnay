<script>
// Earnings Calculator
const nightlyRate = document.getElementById('nightlyRate');
const nightsBooked = document.getElementById('nightsBooked');
const nightsValue = document.getElementById('nightsValue');
const earnings = document.getElementById('earnings');

function calculateEarnings() {
  const rate = parseFloat(nightlyRate.value) || 0;
  const nights = parseInt(nightsBooked.value) || 0;
  const total = rate * nights;
  
  nightsValue.textContent = nights + ' night' + (nights !== 1 ? 's' : '');
  earnings.textContent = '$' + total.toLocaleString();
}

nightlyRate.addEventListener('input', calculateEarnings);
nightsBooked.addEventListener('input', calculateEarnings);
calculateEarnings();
</script>
