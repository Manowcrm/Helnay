<div class="hero-banner" style="position: relative; min-height: 550px; background: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.5)), url('https://images.unsplash.com/photo-1564013799919-ab600027ffc6?w=1920&q=80&auto=format&fit=crop') center/cover; display: flex; align-items: center; padding: 4rem 0;">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-10">
        <div class="text-center text-white mb-4">
          <h1 class="display-3 fw-bold mb-3" style="text-shadow: 2px 2px 8px rgba(0,0,0,0.3); margin-top: 0;">Find Your Perfect Stay</h1>
          <p class="lead fs-4" style="text-shadow: 1px 1px 4px rgba(0,0,0,0.3);">Discover amazing vacation homes around the world</p>
        </div>
        <div class="search-box-wrap p-4 bg-white rounded-4 shadow-lg">
          <form method="GET" action="/">
            <div class="row g-3">
              <div class="col-12 col-md-5">
                <div class="input-group input-group-lg">
                  <span class="input-group-text bg-light border-0"><i class="bi bi-search"></i></span>
                  <input name="q" class="form-control border-0 bg-light" placeholder="Property name or keyword" value="<%= (typeof query !== 'undefined' && query.q) ? query.q : '' %>">
                </div>
              </div>
              <div class="col-12 col-md-4">
                <div class="input-group input-group-lg">
                  <span class="input-group-text bg-light border-0"><i class="bi bi-geo-alt"></i></span>
                  <div class="loc-ac-wrap">
                  <input name="location" class="form-control border-0 bg-light loc-ac-input" 
                         placeholder="City or location"
                         value="<%= (typeof query !== 'undefined' && query.location) ? query.location : '' %>"
                         autocomplete="off">
                  <ul class="loc-ac-dropdown"></ul>
                </div>
                </div>
              </div>
              <div class="col-12 col-md-3">
                <button type="submit" class="btn btn-warning btn-lg w-100 fw-semibold">
                  <i class="bi bi-search"></i> Search
                </button>
              </div>
            </div>
            <div class="row g-2 mt-2">
              <div class="col-6 col-md-3">
                <input name="min_price" class="form-control" placeholder="Min Price" type="number" min="0" value="<%= (typeof query !== 'undefined' && query.min_price) ? query.min_price : '' %>">
              </div>
              <div class="col-6 col-md-3">
                <input name="max_price" class="form-control" placeholder="Max Price" type="number" min="0" value="<%= (typeof query !== 'undefined' && query.max_price) ? query.max_price : '' %>">
              </div>
              <div class="col-12 col-md-6">
                <button type="button" class="btn btn-outline-secondary w-100" data-bs-toggle="collapse" data-bs-target="#advancedFilters">
                  <i class="bi bi-funnel"></i> More Filters
                </button>
              </div>
            </div>
            <div class="collapse mt-3" id="advancedFilters">
              <div class="row g-3">
                <div class="col-6 col-md-3">
                  <label class="form-label small text-muted fw-semibold"><i class="bi bi-list-ul"></i> Category</label>
                  <select name="category" class="form-select">
                    <option value="">All</option>
                    <option value="beach-houses" <%= (query && query.category === 'beach-houses') ? 'selected' : '' %>>Beach Houses</option>
                    <option value="city-stays" <%= (query && query.category === 'city-stays') ? 'selected' : '' %>>City Stays</option>
                    <option value="mountain-retreats" <%= (query && query.category === 'mountain-retreats') ? 'selected' : '' %>>Mountain Retreats</option>
                    <option value="entire-homes" <%= (query && query.category === 'entire-homes') ? 'selected' : '' %>>Entire Homes</option>
                  </select>
                </div>
                <div class="col-6 col-md-3">
                  <label class="form-label small text-muted fw-semibold"><i class="bi bi-door-open"></i> Bedrooms</label>
                  <select name="bedrooms" class="form-select">
                    <option value="">Any</option>
                    <option value="1" <%= (query && query.bedrooms === '1') ? 'selected' : '' %>>1+</option>
                    <option value="2" <%= (query && query.bedrooms === '2') ? 'selected' : '' %>>2+</option>
                    <option value="3" <%= (query && query.bedrooms === '3') ? 'selected' : '' %>>3+</option>
                    <option value="4" <%= (query && query.bedrooms === '4') ? 'selected' : '' %>>4+</option>
                  </select>
                </div>
                <div class="col-6 col-md-3">
                  <label class="form-label small text-muted fw-semibold"><i class="bi bi-people"></i> Guests</label>
                  <select name="guests" class="form-select">
                    <option value="">Any</option>
                    <option value="2" <%= (query && query.guests === '2') ? 'selected' : '' %>>2+</option>
                    <option value="4" <%= (query && query.guests === '4') ? 'selected' : '' %>>4+</option>
                    <option value="6" <%= (query && query.guests === '6') ? 'selected' : '' %>>6+</option>
                    <option value="8" <%= (query && query.guests === '8') ? 'selected' : '' %>>8+</option>
                  </select>
                </div>
                <div class="col-6 col-md-3">
                  <label class="form-label small text-muted fw-semibold"><i class="bi bi-sort-down"></i> Sort By</label>
                  <select name="sort" class="form-select">
                    <option value="">Recommended</option>
                    <option value="price_low" <%= (query && query.sort === 'price_low') ? 'selected' : '' %>>Price: Low to High</option>
                    <option value="price_high" <%= (query && query.sort === 'price_high') ? 'selected' : '' %>>Price: High to Low</option>
                    <option value="newest" <%= (query && query.sort === 'newest') ? 'selected' : '' %>>Newest</option>
                  </select>
                </div>
              </div>
            </div>
            <% if (query && (query.q || query.location || query.min_price || query.max_price || query.category)) { %>
              <div class="mt-2">
                <a href="/" class="btn btn-sm btn-outline-danger">
                  <i class="bi bi-x-circle"></i> Clear Filters
                </a>
              </div>
            <% } %>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Main Content Container -->
<div class="container">

<!-- Host Call-to-Action Banner -->
<div class="my-5">
  <div class="card border-0 shadow-lg" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
    <div class="card-body p-5 text-white text-center">
      <h2 class="display-5 fw-bold mb-3">Own a property? Start earning today!</h2>
      <p class="lead mb-4">Join thousands of hosts who trust Helnay to help them earn extra income from their properties</p>
      <div class="d-flex justify-content-center gap-3 flex-wrap">
        <a href="/become-a-host" class="btn btn-light btn-lg px-5 py-3 shadow">
          <i class="bi bi-house-add"></i> List Your Property
        </a>
        <a href="/become-a-host#calculator" class="btn btn-outline-light btn-lg px-5 py-3">
          <i class="bi bi-calculator"></i> Calculate Earnings
        </a>
      </div>
      <div class="mt-4">
        <small>
          <i class="bi bi-check-circle-fill"></i> No listing fees • 
          <i class="bi bi-check-circle-fill"></i> Lower commission • 
          <i class="bi bi-check-circle-fill"></i> 24/7 support
        </small>
      </div>
    </div>
  </div>
</div>

<div class="container mt-4">
  <div class="row">
    <!-- Sidebar Filters -->
    <div class="col-lg-3 mb-4">
      <div class="sidebar-filters">
        <!-- Booking Options -->
        <div class="filter-section">
          <h6 class="filter-title">Booking Options</h6>
          <div class="filter-options">
            <label class="filter-checkbox">
              <input type="checkbox" class="filter-input" data-filter="instant">
              <span>Instant Booking</span>
            </label>
          </div>
        </div>

        <!-- Dynamic Filter Sections from Database -->
        <% Object.keys(filtersByCategory).forEach(function(category) { %>
        <div class="filter-section">
          <h6 class="filter-title"><%= category %></h6>
          <div class="filter-options">
            <% filtersByCategory[category].forEach(function(filter) { %>
            <button class="filter-button" data-filter="<%= filter.filter_key %>">
              <i class="bi bi-<%= filter.icon %>"></i> <%= filter.name %>
            </button>
            <% }); %>
          </div>
        </div>
        <% }); %>
        
        <% if (Object.keys(filtersByCategory).length === 0) { %>
        <div class="alert alert-info">
          <i class="bi bi-info-circle"></i> No filters available. Admin can add filters from the admin panel.
        </div>
        <% } %>

        <!-- Quick Categories -->
        <div class="filter-section">
          <h6 class="filter-title">Browse by Category</h6>
          <div class="category-links">
            <% if (browseCategories && browseCategories.length > 0) { %>
              <% browseCategories.forEach(function(category) { %>
                <a href="/?<%= category.filter_params %>" class="category-link" title="<%= category.description %>">
                  <i class="bi bi-tag"></i> <%= category.title %>
                </a>
              <% }); %>
            <% } else { %>
              <p class="text-muted small">No categories available</p>
            <% } %>
          </div>
        </div>

        <!-- Price Range -->
        <div class="filter-section">
          <h6 class="filter-title">Price Range</h6>
          <div class="price-inputs">
            <input type="number" class="form-control form-control-sm mb-2" placeholder="Min $" id="priceMin">
            <input type="number" class="form-control form-control-sm" placeholder="Max $" id="priceMax">
            <button class="btn btn-sm btn-primary w-100 mt-2" onclick="applyPriceFilter()">Apply</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content -->
    <div class="col-lg-9">

      <h2 class="mb-4">Available Properties <span class="badge bg-secondary listings-count"><%= listings.length %></span></h2>
      <div class="listings-wrapper">
        <div class="row listings-grid" id="listingsContainer">
  <% if (!listings || listings.length === 0) { %>
    <div class="col-12"><p>No listings found.</p></div>
  <% } %>
  <% listings.forEach(function(l){ %>
    <div class="col-md-4 listing-item" data-amenities="<%= (l.serviceKeys || l.description).toLowerCase() %>">
      <div class="card listing-card h-100">
        <% if (l.image_url) { %>
          <div class="listing-img-wrapper position-relative">
            <a href="/listings/<%= l.id %>" class="text-decoration-none">
              <img src="<%= l.image_url %>" class="card-img-top" alt="<%= l.title %>">
              <span class="badge badge-location"><i class="bi bi-geo-alt"></i> <%= l.location_name || l.location || 'Location not set' %></span>
            </a>
            <% if (user) { %>
              <form method="POST" action="/favorites/toggle/<%= l.id %>" class="favorite-form" style="position:absolute; top:10px; right:10px;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-sm btn-light rounded-circle shadow favorite-btn" title="Add to favorites" data-listing-id="<%= l.id %>">
                  <i class="bi bi-heart<%= (favoriteIds && favoriteIds.includes(l.id)) ? '-fill text-danger' : '' %>"></i>
                </button>
              </form>
            <% } %>
          </div>
        <% } else { %>
          <div class="card-header bg-light">
            <span class="badge badge-location"><i class="bi bi-geo-alt"></i> <%= l.location_name || l.location || 'Location not set' %></span>
          </div>
        <% } %>
        <div class="card-body d-flex flex-column">
          <a href="/listings/<%= l.id %>" class="text-decoration-none">
            <h5 class="card-title text-dark"><%= l.title %></h5>
            <p class="card-text text-muted small mb-2">
              <i class="bi bi-geo-alt-fill text-primary"></i> <%= l.location_name || l.location || 'Location not set' %>
            </p>
            <p class="card-text text-muted small mb-2">
              <i class="bi bi-house"></i> Available for rent
            </p>
            <p class="card-text text-muted"><%= l.description.length > 100 ? l.description.substring(0,100) + '...' : l.description %></p>
          </a>
          <div class="mt-auto">
            <hr>
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <strong class="text-primary fs-5">$<%= l.price %></strong>
                <small class="text-muted">/night</small>
              </div>
              <a href="/listings/<%= l.id %>" class="btn btn-primary">View Details</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% }) %>
        </div>
      </div>

</div>

<script>
// Filter functionality
const filterButtons = document.querySelectorAll('.filter-button');
const listingsContainer = document.getElementById('listingsContainer');
const allListings = Array.from(listingsContainer.children);
let activeFilters = [];

allListings.forEach(listing => {
  listing.dataset.originalDisplay = listing.style.display || 'block';
});

filterButtons.forEach(button => {
  button.addEventListener('click', function() {
    const filter = this.dataset.filter;
    if (this.classList.contains('active')) {
      this.classList.remove('active');
      activeFilters = activeFilters.filter(f => f !== filter);
    } else {
      this.classList.add('active');
      activeFilters.push(filter);
    }
    applyFilters();
  });
});

function applyFilters() {
  const minPrice = parseFloat(document.getElementById('priceMin')?.value) || 0;
  const maxPrice = parseFloat(document.getElementById('priceMax')?.value) || Infinity;
  
  allListings.forEach(listing => {
    const amenities = listing.dataset.amenities || '';
    const title = listing.querySelector('.card-title')?.textContent.toLowerCase() || '';
    const fullText = (title + ' ' + amenities).toLowerCase();
    const priceEl = listing.querySelector('[data-usd-price]');
    const price = priceEl ? parseFloat(priceEl.dataset.usdPrice) : 0;
    const priceMatch = price >= minPrice && price <= maxPrice;
    
    if (activeFilters.length === 0) {
      listing.style.display = priceMatch ? '' : 'none';
      return;
    }
    
    const matches = activeFilters.every(filter => {
      switch(filter) {
        case 'pool': return fullText.includes('pool');
        case 'wifi': return fullText.includes('wifi') || fullText.includes('wi-fi');
        case 'balcony': return fullText.includes('balcony') || fullText.includes('patio') || fullText.includes('terrace') || fullText.includes('deck');
        case 'air-conditioning': return fullText.includes('air conditioning') || fullText.includes('air condition');
        case 'garden': return fullText.includes('garden') || fullText.includes('yard');
        case 'tv': return fullText.includes(' tv,') || fullText.includes(' tv ') || fullText.includes('television') || fullText.includes('smart tv');
        case 'parking': return fullText.includes('parking') || fullText.includes('garage');
        case 'kitchen': return fullText.includes('kitchen');
        case 'washing': return fullText.includes('washing machine') || fullText.includes('laundry');
        case 'microwave': return fullText.includes('microwave');
        case 'dishwasher': return fullText.includes('dishwasher');
        case 'hot-tub': return fullText.includes('hot tub') || fullText.includes('jacuzzi');
        case 'sauna': return fullText.includes('sauna');
        case 'fireplace': return fullText.includes('fireplace');
        case 'cot': return fullText.includes('cot') || fullText.includes('crib');
        case 'pet-friendly': return fullText.includes('pet-friend');
        case 'no-smoking': return fullText.includes('no smoking') || fullText.includes('smoke-free');
        case 'no-pets': return fullText.includes('no pet');
        case 'wheelchair': return fullText.includes('wheelchair');
        case 'fishing': return fullText.includes('fishing');
        case 'grill': return fullText.includes('grill') || fullText.includes('bbq');
        default: return true;
      }
    });
    
    listing.style.display = (matches && priceMatch) ? '' : 'none';
  });
  
  updateListingsCount();
}

function applyPriceFilter() {
  applyFilters();
}

function updateListingsCount() {
  const visibleCount = allListings.filter(l => l.style.display !== 'none').length;
  const countBadge = document.querySelector('.listings-count');
  if (countBadge) countBadge.textContent = visibleCount;
}
</script>

