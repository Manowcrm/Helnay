<div class="hero-banner" style="position:relative;min-height:560px;display:flex;align-items:center;padding:5rem 0;">
  <div class="container" style="animation:none">
    <div class="row justify-content-center">
      <div class="col-lg-10 text-center text-white">
        <div class="hero-chip">
          <i class="bi bi-geo-alt-fill"></i> Kenya &amp; Somalia's #1 Rental Platform
        </div>
        <h1 class="display-3 fw-bold mb-3">Find Your Perfect<br><em>Home in East Africa</em></h1>
        <p class="lead mb-4">Trusted rentals in Nairobi, Mombasa, Kisumu, Mogadishu and beyond.<br>Pay instantly with M-Pesa.</p>
        <div class="search-box-modern p-2">
          <form method="GET" action="/">
            <div class="row g-2 align-items-center">
              <div class="col-12 col-md-5">
                <div class="input-group input-group-lg">
                  <span class="input-group-text"><i class="bi bi-search"></i></span>
                  <input name="q" class="form-control" placeholder="Nairobi, Mombasa, Westlands…" value="<%= (typeof query !== 'undefined' && query.q) ? query.q : '' %>">
                </div>
              </div>
              <div class="col-12 col-md-4">
                <div class="input-group input-group-lg">
                  <span class="input-group-text"><i class="bi bi-geo-alt"></i></span>
                  <input name="location" class="form-control" placeholder="City or neighbourhood" value="<%= (typeof query !== 'undefined' && query.location) ? query.location : '' %>">
                </div>
              </div>
              <div class="col-12 col-md-3">
                <button type="submit" class="btn btn-warning btn-lg w-100 fw-bold">
                  <i class="bi bi-search"></i> Search
                </button>
              </div>
            </div>
            <div class="row g-2 mt-2 collapse" id="advancedFilters">
              <div class="col-6 col-md-3">
                <select name="category" class="form-select">
                  <option value="">All Types</option>
                  <option value="beach-houses" <%= (query && query.category==='beach-houses')?'selected':'' %>>Beach Houses</option>
                  <option value="city-stays" <%= (query && query.category==='city-stays')?'selected':'' %>>City Stays</option>
                  <option value="entire-homes" <%= (query && query.category==='entire-homes')?'selected':'' %>>Entire Homes</option>
                </select>
              </div>
              <div class="col-6 col-md-3">
                <select name="bedrooms" class="form-select">
                  <option value="">Bedrooms</option>
                  <option value="1" <%= (query && query.bedrooms==='1')?'selected':'' %>>1+</option>
                  <option value="2" <%= (query && query.bedrooms==='2')?'selected':'' %>>2+</option>
                  <option value="3" <%= (query && query.bedrooms==='3')?'selected':'' %>>3+</option>
                  <option value="4" <%= (query && query.bedrooms==='4')?'selected':'' %>>4+</option>
                </select>
              </div>
              <div class="col-6 col-md-3">
                <input name="min_price" class="form-control" placeholder="Min KES" type="number" min="0" value="<%= (typeof query!=='undefined' && query.min_price)?query.min_price:'' %>">
              </div>
              <div class="col-6 col-md-3">
                <input name="max_price" class="form-control" placeholder="Max KES" type="number" min="0" value="<%= (typeof query!=='undefined' && query.max_price)?query.max_price:'' %>">
              </div>
            </div>
            <div class="mt-2 d-flex gap-2 justify-content-center flex-wrap">
              <button type="button" class="btn btn-sm btn-outline-light rounded-pill" data-bs-toggle="collapse" data-bs-target="#advancedFilters">
                <i class="bi bi-funnel"></i> More Filters
              </button>
              <% if (query && (query.q || query.location || query.min_price || query.max_price || query.category)) { %>
                <a href="/" class="btn btn-sm btn-outline-danger rounded-pill"><i class="bi bi-x-circle"></i> Clear</a>
              <% } %>
            </div>
          </form>
        </div>
        <div class="trust-pills mt-4">
          <span class="trust-pill"><i class="bi bi-shield-check-fill"></i> Verified Landlords</span>
          <span class="trust-pill"><i class="bi bi-phone-fill"></i> M-Pesa Payments</span>
          <span class="trust-pill"><i class="bi bi-star-fill"></i> 4.8★ Avg Rating</span>
          <span class="trust-pill"><i class="bi bi-headset"></i> 24/7 Support</span>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="container mt-4">

  <!-- City Scroll -->
  <div class="city-scroll-wrap mb-2">
    <span class="city-label">Browse by city:</span>
    <a href="/?location=Nairobi" class="city-tag <%= (typeof query!=='undefined' && query.location==='Nairobi')?'active':'' %>">
      <i class="bi bi-buildings"></i> Nairobi
    </a>
    <a href="/?location=Mombasa" class="city-tag <%= (typeof query!=='undefined' && query.location==='Mombasa')?'active':'' %>">
      <i class="bi bi-water"></i> Mombasa
    </a>
    <a href="/?location=Kisumu" class="city-tag <%= (typeof query!=='undefined' && query.location==='Kisumu')?'active':'' %>">
      <i class="bi bi-droplet"></i> Kisumu
    </a>
    <a href="/?location=Nakuru" class="city-tag <%= (typeof query!=='undefined' && query.location==='Nakuru')?'active':'' %>">
      <i class="bi bi-tree"></i> Nakuru
    </a>
    <a href="/?location=Mogadishu" class="city-tag <%= (typeof query!=='undefined' && query.location==='Mogadishu')?'active':'' %>">
      <i class="bi bi-map"></i> Mogadishu
    </a>
    <a href="/?location=Hargeisa" class="city-tag <%= (typeof query!=='undefined' && query.location==='Hargeisa')?'active':'' %>">
      <i class="bi bi-map-fill"></i> Hargeisa
    </a>
    <a href="/" class="city-tag <%= (!query || !query.location)?'active':'' %>">
      <i class="bi bi-globe"></i> All Cities
    </a>
  </div>

  <div class="row mt-4">
    <!-- Sidebar -->
    <div class="col-lg-3 mb-4">
      <div class="sidebar-filters">
        <div class="filter-section">
          <h6 class="filter-title">Booking Options</h6>
          <label class="filter-checkbox"><input type="checkbox" class="filter-input" data-filter="instant" style="accent-color:var(--g1)"> Instant Booking</label>
        </div>
        <% Object.keys(filtersByCategory).forEach(function(category){ %>
        <div class="filter-section">
          <h6 class="filter-title"><%= category %></h6>
          <div>
            <% filtersByCategory[category].forEach(function(filter){ %>
            <button class="filter-button" data-filter="<%= filter.filter_key %>">
              <i class="bi bi-<%= filter.icon %>"></i> <%= filter.name %>
            </button>
            <% }); %>
          </div>
        </div>
        <% }); %>
        <div class="filter-section">
          <h6 class="filter-title">Browse by Category</h6>
          <div class="category-links">
            <% if (browseCategories && browseCategories.length > 0) { %>
              <% browseCategories.forEach(function(category){ %>
                <a href="/?<%= category.filter_params %>" class="category-link" title="<%= category.description %>">
                  <i class="bi bi-tag"></i> <%= category.title %>
                </a>
              <% }); %>
            <% } else { %>
              <p class="small" style="color:var(--hint)">No categories yet</p>
            <% } %>
          </div>
        </div>
        <div class="filter-section">
          <h6 class="filter-title">Price Range (KES)</h6>
          <div class="price-inputs">
            <input type="number" class="form-control form-control-sm mb-2" placeholder="Min KES" id="priceMin">
            <input type="number" class="form-control form-control-sm" placeholder="Max KES" id="priceMax">
            <button class="btn btn-sm btn-primary w-100 mt-2 rounded-pill" onclick="applyPriceFilter()">Apply</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Listings -->
    <div class="col-lg-9">
      <div class="sec-header mb-3">
        <div>
          <div class="sec-title">Available Properties <span class="badge bg-secondary listings-count ms-1"><%= listings.length %></span></div>
          <div class="sec-sub">Verified properties across East Africa · M-Pesa accepted</div>
        </div>
      </div>
      <div class="row g-3" id="listingsContainer">
        <% if (!listings || listings.length === 0) { %>
          <div class="col-12">
            <div class="text-center py-5" style="color:var(--hint)">
              <i class="bi bi-house-slash" style="font-size:3rem;display:block;margin-bottom:12px"></i>
              <p class="mb-0">No properties found. Try a different search.</p>
            </div>
          </div>
        <% } %>
        <% listings.forEach(function(l){ %>
          <div class="col-md-6 col-lg-4 listing-item" data-amenities="<%= (l.serviceKeys || l.description).toLowerCase() %>">
            <div class="card listing-card h-100">
              <% if (l.image_url) { %>
                <div class="listing-img-wrapper">
                  <a href="/listings/<%= l.id %>" class="text-decoration-none">
                    <img src="<%= l.image_url %>" class="card-img-top" alt="<%= l.title %>">
                    <span class="badge-location"><i class="bi bi-geo-alt-fill"></i> <%= l.location_name || l.location || 'Location not set' %></span>
                  </a>
                  <% if (user) { %>
                    <form method="POST" action="/favorites/toggle/<%= l.id %>" class="favorite-form" style="position:absolute;top:10px;right:10px">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-sm btn-light rounded-circle shadow favorite-btn" data-listing-id="<%= l.id %>">
                        <i class="bi bi-heart<%= (favoriteIds && favoriteIds.includes(l.id))?'-fill text-danger':'' %>"></i>
                      </button>
                    </form>
                  <% } %>
                </div>
              <% } else { %>
                <div class="listing-img-wrapper" style="background:#f0f0ea;display:flex;align-items:center;justify-content:center">
                  <i class="bi bi-house" style="font-size:3rem;color:var(--hint)"></i>
                  <span class="badge-location"><i class="bi bi-geo-alt-fill"></i> <%= l.location_name || l.location || 'Location not set' %></span>
                </div>
              <% } %>
              <div class="card-body d-flex flex-column">
                <a href="/listings/<%= l.id %>" class="text-decoration-none">
                  <h5 class="card-title"><%= l.title %></h5>
                  <p class="card-text text-muted small mb-2">
                    <i class="bi bi-geo-alt-fill" style="color:var(--g3)"></i> <%= l.location_name || l.location || 'Location not set' %>
                  </p>
                  <p class="card-text text-muted"><%= l.description.length > 90 ? l.description.substring(0,90)+'…' : l.description %></p>
                </a>
                <div class="mt-auto">
                  <hr>
                  <div class="d-flex justify-content-between align-items-center">
                    <div>
                      <strong class="text-primary">$<%= l.price %></strong>
                      <small class="text-muted">/night</small>
                    </div>
                    <a href="/listings/<%= l.id %>" class="btn btn-primary btn-sm">View Details</a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>

  <!-- Host CTA -->
  <div class="my-5">
    <div class="card border-0 host-cta-banner">
      <div class="card-body p-0 text-white">
        <div class="row align-items-center g-4">
          <div class="col-lg-8">
            <div style="background:rgba(244,162,97,0.2);border:1px solid rgba(244,162,97,0.4);border-radius:100px;display:inline-flex;align-items:center;padding:4px 14px;font-size:11.5px;font-weight:700;color:#fcd4a0;margin-bottom:12px">For Landlords</div>
            <h2 class="display-5 fw-bold mb-2">Own a property? Start earning today.</h2>
            <p class="mb-3" style="color:rgba(255,255,255,0.7);font-size:15px">Join hundreds of East African landlords earning steady income — with M-Pesa payouts and just 3% commission.</p>
            <div class="d-flex gap-4 mb-4 flex-wrap">
              <div><div class="host-stat-val">KES 45K+</div><div class="host-stat-lbl">avg. monthly earnings</div></div>
              <div><div class="host-stat-val">3%</div><div class="host-stat-lbl">commission only</div></div>
              <div><div class="host-stat-val">&lt;24h</div><div class="host-stat-lbl">to go live</div></div>
            </div>
            <div class="d-flex gap-3 flex-wrap">
              <a href="/become-a-host" class="btn btn-light btn-lg px-4">
                <i class="bi bi-house-add"></i> List Your Property
              </a>
              <a href="/become-a-host#calculator" class="btn btn-outline-light btn-lg px-4">
                <i class="bi bi-calculator"></i> Calculate Earnings
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- More Properties -->
  <div class="mb-5">
    <div class="sec-header">
      <div>
        <div class="sec-title">More Properties</div>
        <div class="sec-sub">Explore more options across East Africa and beyond</div>
      </div>
    </div>
    <div class="row g-3">
      <%
      const featuredRentals = [
        { title:'Luxury Penthouse', location:'Nairobi CBD', price:45000, type:'apartment', image:'https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?w=800&q=80' },
        { title:'Beach Villa – Diani', location:'Mombasa', price:32000, type:'villa', image:'https://images.unsplash.com/photo-1613490493576-7fde63acd811?w=800&q=80' },
        { title:'Modern 2BR Flat', location:'Kilimani, Nairobi', price:8500, type:'apartment', image:'https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?w=800&q=80' },
        { title:'Lakeside Home', location:'Kisumu', price:7000, type:'home', image:'https://images.unsplash.com/photo-1499793983690-e29da59ef1c2?w=800&q=80' },
        { title:'Studio – Westlands', location:'Nairobi', price:5500, type:'studio', image:'https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?w=800&q=80' },
        { title:'Executive Suite', location:'Mogadishu', price:18000, type:'serviced', image:'https://images.unsplash.com/photo-1518780664697-55e3ad937233?w=800&q=80' },
        { title:'Garden Apartment', location:'Lavington, Nairobi', price:12000, type:'apartment', image:'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=800&q=80' },
        { title:'Ocean View Suite', location:'Bamburi, Mombasa', price:14000, type:'apartment', image:'https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?w=800&q=80' },
        { title:'Serviced Apt – Hargeisa', location:'Hargeisa', price:9000, type:'serviced', image:'https://images.unsplash.com/photo-1596721853750-2f8e8c39e826?w=800&q=80' },
        { title:'Penthouse – Upper Hill', location:'Nairobi', price:22000, type:'apartment', image:'https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?w=800&q=80' }
      ];
      %>
      <% featuredRentals.forEach(function(rental){ %>
        <div class="col-md-6 col-lg-3 col-xl-2-4 mb-1">
          <div class="card featured-rental-card h-100">
            <div class="featured-img-wrapper">
              <img src="<%= rental.image %>" alt="<%= rental.title %>">
              <span class="badge-featured">✦ Featured</span>
            </div>
            <div class="card-body">
              <h6 class="card-title"><%= rental.title %></h6>
              <p class="card-text small mb-2" style="color:var(--hint)">
                <i class="bi bi-geo-alt-fill" style="color:var(--g3)"></i> <%= rental.location %>
              </p>
              <div class="d-flex justify-content-between align-items-center">
                <span><strong class="text-primary">KES <%= rental.price.toLocaleString() %></strong><small style="color:var(--hint)">/night</small></span>
                <a href="/?location=<%= rental.location.split(',')[0] %>&type=<%= rental.type %>" class="btn btn-sm btn-outline-primary">View</a>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

</div>

<script>
const filterButtons = document.querySelectorAll('.filter-button');
const listingsContainer = document.getElementById('listingsContainer');
const allListings = Array.from(listingsContainer.children);
let activeFilters = [];

filterButtons.forEach(button => {
  button.addEventListener('click', function() {
    const filter = this.dataset.filter;
    if (this.classList.contains('active')) {
      this.classList.remove('active');
      activeFilters = activeFilters.filter(f => f !== filter);
    } else {
      this.classList.add('active');
      activeFilters.push(filter);
    }
    applyFilters();
  });
});

function applyFilters() {
  const minPrice = parseFloat(document.getElementById('priceMin')?.value) || 0;
  const maxPrice = parseFloat(document.getElementById('priceMax')?.value) || Infinity;
  allListings.forEach(listing => {
    const amenities = listing.dataset.amenities || '';
    const title = listing.querySelector('.card-title')?.textContent.toLowerCase() || '';
    const fullText = (title + ' ' + amenities).toLowerCase();
    const priceText = listing.querySelector('.text-primary')?.textContent || '';
    const price = parseFloat(priceText.replace(/[^0-9.]/g, ''));
    const priceMatch = price >= minPrice && price <= maxPrice;
    if (activeFilters.length === 0) { listing.style.display = priceMatch ? '' : 'none'; return; }
    const matches = activeFilters.every(filter => {
      const map = { pool:'pool', wifi:'wifi|wi-fi', parking:'parking|garage', ac:'air condition', garden:'garden|yard', tv:' tv', kitchen:'kitchen', washer:'washing|laundry', microwave:'microwave', dishwasher:'dishwasher', hottub:'hot tub|jacuzzi', sauna:'sauna', fireplace:'fireplace', 'pet-friendly':'pet-friend', grill:'bbq|grill', generator:'generator', security:'security', borehole:'borehole', furnished:'furnished' };
      const pattern = map[filter];
      return pattern ? pattern.split('|').some(p => fullText.includes(p)) : true;
    });
    listing.style.display = (matches && priceMatch) ? '' : 'none';
  });
  const visibleCount = allListings.filter(l => l.style.display !== 'none').length;
  const badge = document.querySelector('.listings-count');
  if (badge) badge.textContent = visibleCount;
}

function applyPriceFilter() { applyFilters(); }
</script>
