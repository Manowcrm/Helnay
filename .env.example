# Copy this file to .env and fill in your actual values
# NEVER commit .env to Git

# Application
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# Session Secret (REQUIRED - generate a random string)
SESSION_SECRET=your-secret-key-change-this-in-production

# Cookie Domain (set for production)
COOKIE_DOMAIN=.helnay.com

# SendGrid Email Service (required for email notifications)
SENDGRID_API_KEY=your-sendgrid-api-key
ADMIN_EMAIL=your-verified-sender-email@example.com

# Stripe Payment Processing (REQUIRED for payments)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# AWS S3 Backup (optional but recommended)
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
S3_BUCKET=manow-helnay-db-backups

# Email Verification (optional - set to 'true' to require email verification)
REQUIRE_EMAIL_VERIFICATION=true

# Base URL (for email links)
BASE_URL=https://helnay.com

# Google Analytics (optional - get from https://analytics.google.com)
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
